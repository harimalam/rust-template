# Copy to `.env` and adjust. Never commit `.env`.
# Hostnames below are for running the app on your machine (`cargo run`) against
# the compose infra. The compose `app` services override them with in-network names.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=info                      # tracing EnvFilter syntax, e.g. "info,sqlx=warn"
LOG_FORMAT=pretty                   # pretty | json   (use json in staging/production)
PUBLIC_BASE_URL=http://localhost:8080   # used to build links in emails
MAX_BODY_BYTES=1048576              # 1 MiB default request body limit
REQUEST_TIMEOUT_SECS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma separated, or "*" (development only)
TRUST_PROXY_HEADERS=false           # true only behind a trusted reverse proxy (reads X-Forwarded-For)
SHUTDOWN_TIMEOUT_SECS=30
DOCS_ENABLED=true                   # OpenAPI JSON + Scalar UI at /docs (default: off in production)

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:app_password@localhost:5432/app
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=5
RUN_MIGRATIONS_ON_START=false       # prefer `app migrate` as a separate step in staging/production

# ── Valkey (Redis protocol) ──────────────────────────────────────────────────
VALKEY_URL=redis://localhost:6380
CACHE_KEY_PREFIX=app
CACHE_DEFAULT_TTL_SECS=300
CACHE_OP_TIMEOUT_MS=300             # hard bound per cache call; a dead Valkey must not stall requests
CACHE_CIRCUIT_OPEN_SECS=5           # after a connection failure, skip the cache for this long

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (must be at least 32 bytes)
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=app
JWT_ACCESS_TTL_SECS=900             # 15 minutes
JWT_REFRESH_TTL_SECS=2592000        # 30 days
EMAIL_VERIFICATION_TTL_SECS=86400
PASSWORD_RESET_TTL_SECS=3600
REQUIRE_EMAIL_VERIFICATION=true     # block login until the email is verified

# ── Rate limiting / brute-force protection ───────────────────────────────────
RATE_LIMIT_AUTH_MAX=20              # requests per window per IP on /auth/*
RATE_LIMIT_AUTH_WINDOW_SECS=60
LOGIN_MAX_FAILED_ATTEMPTS=5         # per email before temporary lockout
LOGIN_LOCKOUT_SECS=900

# ── SMTP (Mailpit in local dev: http://localhost:8025) ───────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=none                       # none | starttls | tls
SMTP_FROM="App <no-reply@example.com>"

# ── S3-compatible object storage (RustFS) ────────────────────────────────────
S3_ENDPOINT=http://localhost:9000           # endpoint the app talks to
S3_PUBLIC_ENDPOINT=http://localhost:9000    # endpoint embedded in presigned URLs (must be reachable by clients)
S3_REGION=us-east-1
S3_BUCKET=app-files
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true          # development convenience; create buckets via IaC in production
S3_PRESIGN_TTL_SECS=300
MAX_UPLOAD_BYTES=10485760           # 10 MiB
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://app:app_password@localhost:5672/%2f
RABBITMQ_PREFETCH=10
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY_SECS=5         # exponential backoff: base * 2^(attempt-1)

# ── Scheduler (cron, 6 fields: sec min hour day month weekday) ───────────────
CRON_PURGE_EXPIRED_TOKENS="0 0 * * * *"     # hourly
CRON_PURGE_DELETED_NOTES="0 30 3 * * *"     # daily 03:30
SOFT_DELETE_RETENTION_DAYS=30
CRON_LOCK_TTL_SECS=30               # per-tick lock so N scheduler replicas run each job once

# ── Infra containers (read by compose.yaml, not by the app) ──────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app_password
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin-secret
# Host ports (change if they clash with other local services)
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6380
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
RUSTFS_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
